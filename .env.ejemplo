# Copiá este archivo como ".env" (sin .ejemplo) y completá los datos.

# Tu usuario y contraseña del Campus Virtual UTN FRM
CAMPUS_USUARIO=
CAMPUS_CLAVE=

# Token de tu bot (te lo da @BotFather en Telegram)
TELEGRAM_TOKEN=

# Tu chat_id (sacalo con: python campus_monitor.py --chat-id)
TELEGRAM_CHAT_ID=

# Cada cuántos segundos revisa (120 = 2 minutos)
INTERVALO=120

# Tu legajo y apellido + nombre (para encontrar TU nota dentro de las planillas)
LEGAJO=
NOMBRE=

# Cada cuántos segundos revisa las planillas de notas (600 = 10 min)
NOTAS_CADA=600
